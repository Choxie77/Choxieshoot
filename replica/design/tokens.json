{
  "_about": "Choxieshoot dark-mode tokens. Roles follow replica-design; values are Choxieshoot's own (teal accent, system greys). Check with: python3 ~/.agents/skills/replica-design/contrast.py replica/design/tokens.json",
  "mode": "dark",
  "color": {
    "bg": "#1e1e1e",
    "surface": "#2c2c2e",
    "border": "#3a3a3c",
    "border-input": "#8e8e93",
    "text": "#f2f2f7",
    "text-muted": "#b8b8bd",
    "accent": "#35c3ae",
    "on-accent": "#052924",
    "danger": "#ff453a",
    "success": "#32d74b"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["on-accent", "accent"],
    ["accent", "surface", "ui"],
    ["danger", "surface", "ui"],
    ["border-input", "surface", "ui"]
  ],
  "font": {
    "sans": "SF Pro Text, system-ui",
    "mono": "SF Mono, ui-monospace"
  },
  "type": {
    "xs": {"size": 10, "line": 14, "weight": 500},
    "sm": {"size": 12, "line": 16, "weight": 500},
    "base": {"size": 14, "line": 20, "weight": 400},
    "lg": {"size": 16, "line": 22, "weight": 600},
    "xl": {"size": 18, "line": 24, "weight": 600}
  },
  "space": [0, 4, 8, 12, 16, 24],
  "radius": {"sm": 6, "md": 10, "lg": 12},
  "shadow": {
    "window": "0 12px 32px rgba(0,0,0,.35)",
    "toast": "0 2px 10px rgba(0,0,0,.25)"
  },
  "motion": {"fast": "120ms", "base": "160ms", "ease": "ease-out"}
}
